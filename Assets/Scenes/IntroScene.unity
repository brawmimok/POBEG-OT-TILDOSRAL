    - target: {fileID: 7491974722176436467, guid: eda61c8f446085549ae0078e6411a54d, type: 3}
      propertyPath: m_text
      value: "ANNANTO - Map \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\nZanik
        - Map \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\nANNANTO - \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\nZanik
        - \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\nANNANTO
        - \u0417\u0432\u0443\u043A\u043E\u0440\u0435\u0436\u0438\u0441\u0451\u0440\nReshka92
        - \u041C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\nNemi - \u0425\u043E\u0440\u043E\u0448\u0438\u0439
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u0430\nPimpu
        - \u0413\u0435\u0440\u043E\u0439\nNezox - \u041F\u0440\u043E\u0441\u0442\u043E
        \u0442\u0430\u043A\nTrix - \u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A
        \u0442\u0435\u043A\u0441\u0442\u0443\u0440\nANNANTO - \u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A
        \u0442\u0435\u043A\u0441\u0442\u0443\u0440\nZing \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F
        - \u0444\u0440\u0435\u043D\u0434\u0441\u043F\u043B\u0435\u0439 \u0440\u0430\u0441\u043F\u0430\u043B\u0441\u044F\nUVI
        - \u0415\u0433\u043E \u0432\u043E\u043E\u0431\u0449\u0435 \u043A\u0442\u043E-\u0442\u043E
        \u043F\u043E\u043C\u043D\u0438\u0442?\nRatstar - \u0421\u0430\u043C\u044B\u0439
        \u0434\u043E\u0431\u0440\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
        \u043D\u0430 \u0441\u0432\u0435\u0442\u0435\nArmaed66 - \u0447\u0442\u043E\u0431\u044B
        \u0436\u0438\u0437\u043D\u044C \u043C\u0430\u043B\u0438\u043D\u043E\u0439
        \u043D\u0435 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C\nJacek \"Fragik\"
        Rogal - SCP: Secret Laboratory Christmas\n\xAB\u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430\xBB
        - \u0432\u0441\u0435 \u043F\u0440\u0430\u0432\u0430 \u043D\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439
        \u043C\u0443\u043B\u044C\u0442\u0441\u0435\u0440\u0438\u0430\u043B\u0430
        \xAB\u041B\u0443\u043D\u0442\u0438\u043A\xBB\nANNANTO - \u041B\u0443\u0447\u0448\u0438\u0439
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\nKetu - \u041B\u0443\u0447\u0448\u0438\u0439
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\nANNANTO - \u041B\u0443\u0447\u0448\u0438\u0439
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\nZanik - \u041B\u0443\u0447\u0448\u0438\u0439
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\n\u041B\u0430\u0442\u044B\u0448\u0441\u043A\u0438\u0439
        \u0433\u0435\u0440\u043E\u0439 - \u0433\u0435\u0440\u043E\u0439\nANNANTO
        -  \u042F \u043F\u043E\u0434\u0443\u043C\u0430\u044E\nZanik - \u042F \u043F\u043E\u0434\u0443\u043C\u0430\u044E\nANNANTO
        -  \u041D\u0435\u0442, \u043D\u0435 \u0434\u0443\u043C\u0430\u0439\nZanik
        - \u041D\u0435 \u0431\u0443\u0434\u0443"
      objectReference: {fileID: 0}
