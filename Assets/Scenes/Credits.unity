  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0418\u0433\u0440\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430
    \u043D\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u0445
    \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430 SCP Foundation\n\nANNANTO
    - \u0414\u0438\u0437\u0430\u0439\u043D\u0435\u0440 \u043A\u0430\u0440\u0442\nZanik
    - \u0414\u0438\u0437\u0430\u0439\u043D\u0435\u0440 \u043A\u0430\u0440\u0442\nANNANTO
    - \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\nZanik -
    \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\nANNANTO -
    \u0417\u0432\u0443\u043A\u043E\u0440\u0435\u0436\u0438\u0441\u0451\u0440\nReshka92
    - \u041C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\nNemi - \u0425\u043E\u0440\u043E\u0448\u0438\u0439
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u0430\nPimpu
    - \u0413\u0435\u0440\u043E\u0439\nNezox - \u041F\u0440\u043E\u0441\u0442\u043E
    \u0442\u0430\u043A\nTrix - \u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A \u0442\u0435\u043A\u0441\u0442\u0443\u0440\nANNANTO
    - \u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A \u0442\u0435\u043A\u0441\u0442\u0443\u0440\nZing
    \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F - \u0444\u0440\u0435\u043D\u0434\u0441\u043F\u043B\u0435\u0439
    \u0440\u0430\u0441\u043F\u0430\u043B\u0441\u044F\nUVI - \u0415\u0433\u043E \u0432\u043E\u043E\u0431\u0449\u0435
    \u043A\u0442\u043E-\u0442\u043E \u043F\u043E\u043C\u043D\u0438\u0442?\nRatstar
    - \u0421\u0430\u043C\u044B\u0439 \u0434\u043E\u0431\u0440\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u043D\u0430 \u0441\u0432\u0435\u0442\u0435\nArmaed66 - \u0447\u0442\u043E\u0431\u044B
    \u0436\u0438\u0437\u043D\u044C \u043C\u0430\u043B\u0438\u043D\u043E\u0439 \u043D\u0435
    \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C\nANNANTO - \u041B\u0443\u0447\u0448\u0438\u0439
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\nMehdi Shahsavan - Bench_ Park\nKetu
    - \u041B\u0443\u0447\u0448\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\nANNANTO
    - \u041B\u0443\u0447\u0448\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\nZanik
    - \u041B\u0443\u0447\u0448\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\n\u041B\u0430\u0442\u044B\u0448\u0441\u043A\u0438\u0439
    \u0433\u0435\u0440\u043E\u0439 (\u041C\u043E\u043A\u043E\u043A\u0438) - \u0433\u0435\u0440\u043E\u0439\nANNANTO
    -  \u042F \u043F\u043E\u0434\u0443\u043C\u0430\u044E\nZanik - \u042F \u043F\u043E\u0434\u0443\u043C\u0430\u044E\nANNANTO
    -  \u041D\u0435\u0442, \u043D\u0435 \u0434\u0443\u043C\u0430\u0439\nZanik - \u041D\u0435
    \u0431\u0443\u0434\u0443\n\n\u0422\u0438\u0442\u0440\u044B \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435
    \u0432 Credits.txt"
